@section Styles {
    <link href="~/css/whatsapp.css" rel="stylesheet" asp-append-version="true" />
}

<section class="card card-body mb-4"><form id="account-form" class="row align-items-end g-3"><div class="col-md-8"><label for="account-name" class="form-label">Nome da nova conta</label><input id="account-name" name="nome" class="form-control" placeholder="Ex.: Atendimento comercial" required maxlength="100" /></div><div class="col-md-4"><button class="btn btn-primary"><i class="fa-solid fa-plus"></i> Adicionar conta</button><button type="button" class="btn btn-outline-secondary ms-2" id="refresh-accounts"><i class="fa-solid fa-rotate"></i> Atualizar</button></div></form></section>
<div id="accounts" class="row g-3">Carregando contas…</div>
<div class="modal fade" id="qr-modal" tabindex="-1" aria-labelledby="qr-title"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h2 class="modal-title" id="qr-title">Conectar WhatsApp</h2><button class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button></div><div class="modal-body text-center"><p>No WhatsApp, abra <strong>Aparelhos conectados → Conectar aparelho</strong> e escaneie o código.</p><div id="qr-content"></div><p class="text-muted mt-3" id="qr-status">Aguardando conexão…</p></div></div></div></div>
