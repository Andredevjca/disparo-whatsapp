@section Styles {
    <link href="~/css/massa.css" rel="stylesheet" asp-append-version="true" />
}

<section class="card card-body mb-4">
    <h2>Importar contatos</h2>
    <form id="import-form" class="row g-3 align-items-end">
        <div class="col-md-4"><label for="import-name" class="form-label">Nome do grupo</label><input id="import-name"
                                                                                                          name="nome" class="form-control" placeholder="Ex.: Clientes de setembro" /></div>
            <div class="col-md-5"><label for="import-file" class="form-label">Planilha CSV ou XLSX</label><input
                id="import-file" name="arquivo" type="file" accept=".csv,.xlsx" class="form-control" required /></div>
                <div class="col-md-3"><button class="btn btn-primary"><i class="fa-solid fa-file-import"></i> Importar
                    contatos</button></div>
                </form>
                <div class="form-text mt-2">Inclua a coluna telefone. As demais colunas podem ser usadas como variáveis na mensagem.
                    Números inválidos e duplicados são identificados na importação.</div>
                </section>
                <section class="card mb-4">
                    <div class="card-header">
                        <h2 class="mb-0">Grupos de contatos</h2>
                    </div>
                    <div id="groups" class="card-body">Carregando…</div>
                </section>
                <section id="group-detail" hidden class="mb-4">
                    <div class="row g-4">
                        <div class="col-lg-7">
                            <div class="card card-body">
                                <h2 id="group-title">Contatos do grupo</h2>
                                <form id="contact-search" class="d-flex gap-2 mb-3"><input name="busca" class="form-control"
                                                                                               placeholder="Buscar nome ou telefone" aria-label="Buscar contatos" /><button
                                    class="btn btn-outline-secondary">Buscar</button></form>
                                    <div id="contacts"></div>
                                    <div id="contacts-pager" class="mt-3"></div>
                                </div>
                            </div>
                            <div class="col-lg-5">
                                <div class="card card-body">
                                    <h2>Preparar disparo</h2>
                                    <form id="bulk-form">
                                        <partial name="_Composer" />
                                        <div class="mb-3"><label for="interval" class="form-label">Intervalo entre envios
                                            (segundos)</label><input id="interval" name="intervalo" type="number" min="1" step="1"
                                                                     value="3" class="form-control" required /></div>
                                            <details class="mb-3">
                                                <summary>Prévia com os dados do contato</summary>
                                                <div id="message-preview" class="message-bubble mt-2"></div>
                                            </details><button class="btn btn-primary"><i class="fa-solid fa-play"></i> Iniciar disparo</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section id="bulk-progress" class="card card-body" hidden>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h2 class="mb-0">Acompanhamento do disparo</h2><button id="stop-bulk" class="btn btn-outline-danger"><i
                                class="fa-solid fa-stop"></i> Parar disparo</button>
                            </div>
                            <div id="bulk-summary"></div>
                            <div class="progress my-3" role="progressbar" aria-label="Progresso dos envios" aria-valuemin="0"
                                 aria-valuemax="100">
                                <div id="bulk-bar" class="progress-bar bg-success"></div>
                            </div>
                            <div id="bulk-details"></div>
                        </section>