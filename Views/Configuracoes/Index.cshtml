@section Styles {
    <link href="~/css/configuracoes.css" rel="stylesheet" data-page-style asp-append-version="true" />
}

<section class="card card-body settings-card"><h2>Preferências de envio</h2><form id="settings-form"><div class="mb-3"><label for="settings-interval" class="form-label">Intervalo padrão entre envios (segundos)</label><input id="settings-interval" name="intervalo" type="number" min="1" step="1" value="3" required class="form-control" /><div class="form-text">Mínimo de 1 segundo. Você também pode ajustar o intervalo ao preparar cada disparo.</div></div><button class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> Salvar configurações</button></form></section>
