<div class="row g-4"><div class="col-lg-8"><section class="card card-body"><div id="users">Carregando usuários…</div></section></div><div class="col-lg-4"><section class="card card-body"><h2 id="user-title">Novo usuário</h2><form id="user-form"><input type="hidden" name="id" /><div class="mb-3"><label for="user-name" class="form-label">Nome</label><input id="user-name" name="nome" class="form-control" maxlength="255" /></div><div class="mb-3"><label for="user-email" class="form-label">E-mail</label><input id="user-email" name="email" type="email" class="form-control" autocomplete="off" required /></div><div class="mb-3"><label for="user-password" class="form-label">Senha</label><input id="user-password" name="password" type="password" class="form-control" autocomplete="new-password" required /><div class="form-text">Ao editar, deixe em branco para manter a senha atual.</div></div><button class="btn btn-primary"><i class="fa-solid fa-check"></i> Salvar</button><button id="reset-user" type="button" class="btn btn-outline-secondary">Cancelar</button></form></section></div></div>
