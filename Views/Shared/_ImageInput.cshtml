<div class="mb-3"><label for="image-file" class="form-label">Imagem (opcional)</label><input type="file" id="image-file" class="form-control" accept="image/png,image/jpeg" /><div class="form-text">PNG ou JPEG, até 5 MB.</div><div id="image-area" class="mt-2" hidden><img id="image-preview" alt="Prévia da imagem selecionada" class="attachment-preview" /><button id="remove-image" class="btn btn-outline-danger ms-2" type="button"><i class="fa-solid fa-trash-can"></i> Remover imagem</button></div></div>
