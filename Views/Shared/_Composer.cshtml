<div class="mb-3"><label for="instance" class="form-label">Conta WhatsApp</label><select id="instance" name="instance"
                                                                                         class="form-select" required>
    <option value="">Carregando contas…</option>
</select>
<div class="form-text">Selecione uma conta conectada para enviar.</div>
</div>
<div class="mb-3"><label for="template" class="form-label">Modelo de mensagem</label><select id="template"
